{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jira-board.local/config/jira-board.config.schema.json",
  "title": "Jira Board project configuration",
  "type": "object",
  "required": ["version", "user", "endpoints", "connector", "mcp", "ai", "timeouts", "refresh", "schedule", "reports", "archive", "app"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "user": {
      "type": "object",
      "required": ["name", "accountId", "email"],
      "properties": {
        "name": { "type": "string" },
        "accountId": { "type": "string" },
        "email": { "type": "string" }
      },
      "additionalProperties": false
    },
    "endpoints": {
      "type": "object",
      "required": ["jiraBase", "confluenceBase", "bitbucketBase"],
      "properties": {
        "jiraBase": { "type": "string" },
        "confluenceBase": { "type": "string" },
        "bitbucketBase": { "type": "string" },
        "checkmarxBase": { "type": "string", "default": "" },
        "checkmarxAuthUrl": { "type": "string", "default": "" },
        "dynatraceTenants": { "type": "object", "additionalProperties": { "type": "string" }, "default": {} }
      },
      "additionalProperties": false
    },
    "excludeProjects": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "bitbucket": {
      "type": "object",
      "properties": {
        "projectMap": { "type": "object", "additionalProperties": { "type": "string" }, "default": {} },
        "repoHints": {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "jenkins": {
      "type": "object",
      "description": "Jenkins pipelines. jobs.<repo slug>.<env> = https multibranch job URL (explicit; an http URL is skipped). root = the folder that holds your projects — discovery walks it to find each repository's pipelines (JENKINS_ROOT_URL in setup/.env wins; keep the real value in your personal config or setup/.env, never in the tracked file). Builds are read with JENKINS_USER + JENKINS_API_TOKEN from setup/.env.",
      "properties": {
        "jobs": {
          "type": "object",
          "additionalProperties": { "type": "object", "additionalProperties": { "type": "string" } },
          "default": {}
        },
        "root": { "type": "string", "default": "" },
        "discovery": {
          "type": "object",
          "description": "How discovery maps a repository to its pipelines. Every key is optional; the defaults are in jira-intern/jenkins.py.",
          "properties": {
            "appFolderRegex": { "type": "string", "description": "Template for the application folder name, {slug} = the repository slug, e.g. \"^{slug}(-.*)?$\". Empty = the default rule (case and punctuation ignored, slug equals the name or a run of whole words of it)." },
            "envPatterns": {
              "type": "object",
              "description": "environment label -> words (regex fragments, matched between non-alphanumerics, case-insensitive) found in a folder or pipeline name. A label given here replaces its default list; new labels are added.",
              "additionalProperties": { "type": "array", "items": { "type": "string" } }
            },
            "kindPatterns": {
              "type": "object",
              "description": "build / deploy -> words in a pipeline name that mark it as a build or a deploy pipeline.",
              "properties": { "build": { "type": "array", "items": { "type": "string" } }, "deploy": { "type": "array", "items": { "type": "string" } } },
              "additionalProperties": false
            },
            "maxDepth": { "type": "integer", "minimum": 1, "maximum": 8, "default": 4 },
            "cacheMinutes": { "type": "integer", "minimum": 0, "maximum": 10080, "default": 60 },
            "buildScan": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25, "description": "How many recent builds of a parameterised job are scanned for the branch." },
            "maxCalls": { "type": "integer", "minimum": 5, "maximum": 500, "default": 150, "description": "Folder reads one discovery walk may spend." }
          },
          "additionalProperties": false,
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "connector": {
      "type": "object",
      "required": ["active"],
      "properties": { "active": { "type": "string", "enum": ["cursor", "claude", "codex"] } },
      "additionalProperties": {
        "type": ["object", "string"],
        "properties": {
          "bin": { "type": "string" },
          "binFallbacks": { "type": "array", "items": { "type": "string" } },
          "promptFlag": { "type": "string" },
          "extraArgs": { "type": "array", "items": { "type": "string" } },
          "modelFlag": { "type": "string" },
          "apiKeyEnv": { "type": "string" },
          "install": { "type": "string" }
        }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["enabled", "read", "write"],
        "properties": {
          "enabled": { "type": "boolean" },
          "read": { "type": "boolean" },
          "write": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "models": {
      "type": "object",
      "properties": {
        "main": { "type": "string" },
        "summary": { "type": "string" },
        "report": { "type": "string" },
        "catalog": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ai": {
      "type": "object",
      "required": ["level", "backend", "cloudProvider", "cloudEffort", "useHostOllama"],
      "properties": {
        "level": { "enum": ["none", "low", "moderate", "full"] },
        "backend": { "enum": ["local", "cloud"] },
        "localModel": { "type": "string" },
        "cloudProvider": { "enum": ["claude", "cursor", "gemini"] },
        "cloudModel": { "type": "string" },
        "cloudEffort": { "enum": ["low", "medium", "high", "auto"] },
        "useHostOllama": { "type": "boolean" },
        "ollamaEnabled": { "type": "boolean" },
        "parallel": { "type": "integer", "minimum": 1, "maximum": 10 }
      },
      "additionalProperties": false
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "refresh": {
      "type": "object",
      "required": ["onStart"],
      "properties": {
        "onStart": { "type": "boolean" },
        "workers": { "type": "integer", "minimum": 1, "maximum": 16 }
      },
      "additionalProperties": false
    },
    "schedule": {
      "type": "object",
      "required": ["activeRefresh", "fullRefresh", "reportRefresh"],
      "properties": {
        "activeRefresh": { "enum": ["off", "daily", "twice-daily"] },
        "fullRefresh": { "enum": ["off", "daily", "weekly", "twice-weekly"] },
        "reportRefresh": { "enum": ["off", "daily", "weekly", "twice-weekly"] }
      },
      "additionalProperties": false
    },
    "reports": {
      "type": "object",
      "required": ["autoGenerate", "year", "maxPerRun", "defaultWindowDays", "presetWindowDays"],
      "properties": {
        "autoGenerate": { "type": "boolean" },
        "year": { "type": "integer", "minimum": 2000 },
        "maxPerRun": { "type": "integer", "minimum": 1 },
        "defaultWindowDays": { "type": "integer", "minimum": 1 },
        "presetWindowDays": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
      },
      "additionalProperties": false
    },
    "archive": {
      "type": "object",
      "required": ["maxFetch", "workers", "defaultWindowDays", "presetWindowDays"],
      "properties": {
        "maxFetch": { "type": "integer", "minimum": 1 },
        "workers": { "type": "integer", "minimum": 1 },
        "defaultWindowDays": { "type": "integer", "minimum": 1 },
        "presetWindowDays": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
      },
      "additionalProperties": false
    },
    "app": {
      "type": "object",
      "required": ["servePort", "requiredApprovals", "timeZone", "doneBoardDays", "polling", "progress", "settingsDefaults", "branding"],
      "properties": {
        "servePort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "requiredApprovals": { "type": "integer", "minimum": 1 },
        "timeZone": { "type": "string", "minLength": 1 },
        "doneBoardDays": { "type": "integer", "minimum": 0 },
        "polling": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 250 }
        },
        "progress": {
          "type": "object",
          "properties": {
            "prepPercent": { "type": "number", "minimum": 0, "maximum": 100 },
            "buildMaxPercent": { "type": "number", "minimum": 0, "maximum": 100 }
          },
          "additionalProperties": false
        },
        "settingsDefaults": {
          "type": "object",
          "properties": {
            "themeMode": { "enum": ["auto", "fixed", "schedule"] },
            "theme": { "enum": ["dark", "light"] },
            "dayStart": { "type": "integer", "minimum": 0, "maximum": 23 },
            "dayEnd": { "type": "integer", "minimum": 0, "maximum": 23 },
            "toastSeconds": { "type": "integer", "minimum": 2, "maximum": 10 },
            "toastMax": { "type": "integer", "minimum": 1, "maximum": 10 },
            "features": { "type": "object", "additionalProperties": { "type": "boolean" } }
          },
          "additionalProperties": false
        },
        "branding": {
          "type": "object",
          "properties": {
            "tagline": { "type": "string" },
            "badgeText": { "type": "string" },
            "badgeUrl": { "type": "string" },
            "badgeTitle": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
