# Keep the build context small and reproducible. node_modules is always rebuilt
# inside the image. dist/ IS shipped: with DIST_SOURCE=prebuilt the image packages
# the host-built board (the Docker VM's network is too flaky for in-image npm ci);
# the default in-image build simply overwrites it.
.git
.gitignore
.gitattributes
.github
node_modules
tests

# Secrets must never enter the build context (the templates in setup/ end in
# .template and are kept — the server serves /setup and /docs). Unlike .gitignore, a
# pattern here only matches at the root unless it starts with **/ — and the board's
# own keys live in setup/.env, so every rule is anchored both ways.
.env
.env.*
*.env
**/.env
**/.env.*
**/*.env

# Editor / OS noise
.DS_Store
*.swap
*.log
**/__pycache__

# Cursor / agent local state (never needed in the image)
.cursor
.claude
agent-transcripts

# jira-intern runtime cruft — regenerated at runtime, must not be baked in.
# NOTE: data.json / data.js / *.py / prompts ARE kept on purpose so
# the board has content and the fetch scripts work the moment the container starts.
jira-intern/logs
jira-intern/cache
jira-intern/*.lock
jira-intern/.*.lock
jira-intern/.data.*
jira-intern/.data.lock
jira-intern/.tmp-*
jira-intern/.state.json
jira-intern/_STATUS.md
# Per-machine state written by the board (Settings, schedule, AI queue, progress, overrides).
jira-intern/.settings.json
jira-intern/.settings.json.*.tmp
jira-intern/.schedule.json
jira-intern/.ai-queue
jira-intern/.ai-status.json
jira-intern/.ai-cancel-report
jira-intern/.progress.json
jira-intern/.pr_overrides.json
jira-intern/*.bak
# Company content that only ever lives on the host (also git-ignored).
jira-intern/reports
jira-intern/jira-export.xml
jira-intern/models
jira-intern/status.html
jira-intern/tickets
jira-intern/assets
# Superseded legacy fetcher with hardcoded identity — never ship it.
jira-intern/.fetch-intern.py
