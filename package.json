{
  "name": "jira-board",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "description": "Personal, beautiful JIRA replacement board. Renders the dump produced by the bundled jira-intern/ agent pipeline.",
  "scripts": {
    "dev": "vite --config tooling/vite.config.ts",
    "typecheck": "tsc --noEmit -p src",
    "prebuild": "npm run test:changed && npm run lint:hooks && node scripts/build-help-data.mjs && npm test",
    "build": "npm run build:app",
    "build:app": "node scripts/build-help-data.mjs && tsc --noEmit -p src && vite build --config tooling/vite.config.ts",
    "postbuild": "npm run test:production",
    "help:data": "node scripts/build-help-data.mjs",
    "test": "node scripts/run-tests.mjs all",
    "test:py": "node scripts/run-tests.mjs py",
    "test:js": "node scripts/run-tests.mjs js",
    "test:coverage": "node scripts/run-tests.mjs coverage",
    "test:production": "node scripts/run-tests.mjs production",
    "test:e2e": "npm run build && npm run test:e2e:built",
    "test:e2e:built": "node scripts/run-tests.mjs e2e",
    "test:e2e:smoke": "npm run build && node scripts/run-tests.mjs e2e-smoke",
    "test:changed": "node scripts/run-tests.mjs policy",
    "test:config": "node scripts/run-tests.mjs config",
    "lint:hooks": "node scripts/lint-changed-hooks.mjs",
    "verify:fast": "npm run test:changed && npm run lint:hooks && npm run typecheck && npm run test:js",
    "verify": "npm run config:validate && npm run build && npm run test:coverage && npm run test:e2e:built",
    "config:validate": "node jira-intern/local-runner/config.mjs validate",
    "preview": "vite preview --config tooling/vite.config.ts",
    "serve": "node server/serve.mjs",
    "open": "open dist/index.html",
    "help": "open help/00-start-here.html"
  },
  "dependencies": {
    "motion": "^14.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.6",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
