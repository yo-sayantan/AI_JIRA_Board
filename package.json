{
  "name": "jira-board",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "description": "Personal, beautiful JIRA replacement board. Renders the dump produced by the bundled jira-intern/ agent pipeline.",
  "scripts": {
    "dev": "vite --config tooling/vite.config.ts",
    "typecheck": "tsc --noEmit -p src",
    "prebuild": "node scripts/build-help-data.mjs",
    "build": "tsc --noEmit -p src && vite build --config tooling/vite.config.ts",
    "help:data": "node scripts/build-help-data.mjs",
    "test": "npm run test:py && npm run test:js",
    "test:py": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:js": "vitest run --config tooling/vitest.config.ts",
    "test:config": "python3 tests/test_config.py",
    "config:validate": "node jira-intern/local-runner/config.mjs validate",
    "preview": "vite preview --config tooling/vite.config.ts",
    "serve": "node server/serve.mjs",
    "open": "open dist/index.html",
    "help": "open help/00-start-here.html"
  },
  "dependencies": {
    "motion": "^14.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
