node_modules
*.log
.DS_Store
__pycache__/
.claude/*
!.claude/CLAUDE.md
*.swap
# IDE scanner state (the Checkmarx plugin rewrites it on every scan)
.vscode/.checkmarxIgnored

# ── SECRETS — never commit real tokens ──────────────────────────────────────
# The board's API keys live in setup/.env (written by the board's API keys dialog;
# the list of keys is the tracked setup/api-keys.json). `.env` below matches it at any
# depth. The safe, empty setup/*.template files are NOT matched and stay tracked.
.env
.env.*
*.env
*.env.local
secrets.env
mcp-secrets.env
!setup/*.template

# Build output (rebuild with: npm run build)
dist/

# Superseded legacy fetcher, kept locally but never published: it predates the
# config.json indirection and still has hardcoded identity/endpoints inside it.
# daily_fetch.py replaced it.
jira-intern/.fetch-intern.py

# ── jira-intern runtime data — company ticket content, NEVER commit ──
jira-intern/data.json
jira-intern/data.js
# PR Readiness Reports — generated per ticket from real PR/Jira/Bitbucket content. Local only.
jira-intern/reports/
# Written by the board's Settings panel (AI usage level) — per-machine, not project config.
jira-intern/.settings.json
jira-intern/.settings.json.*.tmp
jira-intern/.schedule.json
jira-intern/.ai-queue/
jira-intern/.health/
jira-intern/.ai-status.json
jira-intern/.ai-cancel-report
jira-intern/.report.lock
jira-intern/.data.lock
jira-intern/cache/
jira-intern/logs/
jira-intern/.state.json
jira-intern/_STATUS.md
jira-intern/.progress.json
jira-intern/.pr_overrides.json
jira-intern/*.lock
jira-intern/.*.lock
jira-intern/*.bak
jira-intern/.data.*
jira-intern/.tmp-*
jira-intern/jira-export.xml
# Local AI models: Ollama's store (pulled models) and hand-dropped GGUF weights. The directory
# gates the AI-Ollama container (server/ollama.mjs); only its README is tracked.
jira-intern/models/*
!jira-intern/models/README.md

# Retired legacy UI (pre-React) — rendered HTML holds real ticket content
jira-intern/status.html
jira-intern/tickets/
jira-intern/assets/

# Jira XML exports dropped in for import-jira-xml.mjs
my_dashboard.xml

# NOTE: project defaults live in config/jira-board.config.json (tracked, no secrets);
# your personal name/id/endpoint overrides go in ~/.ai/config.json, outside the repo.
# API keys live only in setup/.env (git-ignored above; see docs/SETUP.md).
